# ---------------------------------------------------------------------------
# NIOS release hygiene
# ---------------------------------------------------------------------------

# Python bytecode / build artefacts
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so
build/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Node / cockpit build inputs (the compiled dist/ IS tracked and served)
node_modules/
**/node_modules/

# Runtime state, workspaces and secrets
data/
*.log
.nios/
.env
.env.*

# Ring 0 credential custody: never commit key material
ring0_vault/silos/key_vault/.secrets/
ring0_vault/silos/key_vault/.broker_secrets/
**/.broker_secrets/
**/.secrets/
*.key
*.pem
# Write-only LLM key dumps and TigerBeetle data files are never source
llm_keys.json
*.tigerbeetle
*.tigerbeetle.replica

# Donor harvest staging -- reference only, never imported by runtime code
_donor_staging/

# Scratch
temp_sections.txt
